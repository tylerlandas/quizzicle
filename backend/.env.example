# MongoDB connection string.
# Local dev default (used if unset): mongodb://localhost:27017/quizzicle
# Production (Render): set to your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/quizzicle

# Port Express listens on. Render sets this automatically — leave unset there.
PORT=3001

# Comma-separated list of extra allowed CORS origins, on top of the
# localhost dev origins which are always allowed. Set this on Render to
# your deployed frontend's URL(s), e.g.:
# ALLOWED_ORIGIN=https://quizzicle.vercel.app
ALLOWED_ORIGIN=
